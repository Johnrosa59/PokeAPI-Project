<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- android.permission.INTERNET now lives in :data's own manifest,
         since :data is the module that actually talks to the network.
         The Gradle "manifest merger" combines every module's manifest
         into this single final one automatically. -->

    <application
        android:name=".di.BaseApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PokeAPIRecyclerView">
        <!-- MainActivity is now declared inside :feature:pokemonlist's own
             AndroidManifest.xml, since that module owns the screen. It gets
             merged into this final manifest at build time. -->
    </application>

</manifest>